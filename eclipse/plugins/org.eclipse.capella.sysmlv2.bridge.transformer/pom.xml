<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.capella.sysmlv2</groupId>
        <artifactId>capella-sysmlv2-eclipse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>
    <artifactId>org.eclipse.capella.sysmlv2.bridge.transformer</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>eclipse-plugin</packaging>

    <dependencies>
        <dependency>
            <groupId>org.obeonetwork.capella.sysmlv2</groupId>
            <artifactId>capella2sysmlv2-transformer</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.syson</groupId>
            <artifactId>syson-sysml-metamodel</artifactId>
            <version>2026.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.arcadia</groupId>
            <artifactId>arcadia-library</artifactId>
            <version>0.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.sirius</groupId>
            <artifactId>org.eclipse.sirius.emfjson</artifactId>
            <version>2.5.3-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>org.eclipse.emf</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-embedded-runtime</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency</outputDirectory>
                            <includeArtifactIds>capella2sysmlv2-transformer,syson-sysml-metamodel,arcadia-library,org.eclipse.sirius.emfjson,gson,java-uuid-generator,commons-text,commons-lang3</includeArtifactIds>
                            <excludeTransitive>false</excludeTransitive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
