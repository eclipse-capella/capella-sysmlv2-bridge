<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.capella.sysmlv2</groupId>
        <artifactId>capella-sysmlv2-eclipse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>
    <artifactId>org.eclipse.capella.sysmlv2.bridge.mappings</artifactId>
    <packaging>eclipse-plugin</packaging>

    <dependencies>
		<dependency>
		  <groupId>org.slf4j</groupId>
		  <artifactId>slf4j-api</artifactId>
		  <version>${slf4j.version}</version>
		</dependency>
		<dependency>
		  <groupId>org.eclipse.capella</groupId>
		  <artifactId>capella-model-services</artifactId>
		  <version>${capella.for.syson.version}</version>
		</dependency>
		<dependency>
		  <groupId>org.eclipse.capella</groupId>
		  <artifactId>capella-model-transverse-services</artifactId>
		  <version>${capella.for.syson.version}</version>
		</dependency>
        <dependency>
            <groupId>org.eclipse.syson</groupId>
            <artifactId>syson-model-services</artifactId>
            <version>${syson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.syson</groupId>
            <artifactId>syson-services</artifactId>
            <version>${syson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
						<?m2e ignore?>
                        <id>copy-embedded-runtime</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency</outputDirectory>
                            <includeArtifactIds>capella-model-services, syson-model-services, capella-model-transverse-services, slf4j-api, syson-services</includeArtifactIds>
                            <excludeTransitive>false</excludeTransitive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
