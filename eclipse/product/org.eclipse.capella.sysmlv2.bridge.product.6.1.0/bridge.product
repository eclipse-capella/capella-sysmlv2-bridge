<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="Capella SysML v2 Bridge" uid="org.eclipse.capella.sysmlv2.bridge.product.6.1.0" id="org.eclipse.capella.sysmlv2.bridge.application.product" application="org.eclipse.capella.sysmlv2.bridge.application" version="0.1.0.qualifier" type="mixed" includeLaunchers="true" autoIncludeRequirements="false">

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <vmArgs>-Dosgi.requiredJavaVersion=17
-Dpde.jreProfile=JavaSE-17
-Dfile.encoding=UTF-8
-Dsun.stdout.encoding=UTF-8
-Dsun.stderr.encoding=UTF-8
      </vmArgs>
   </launcherArgs>

   <windowImages/>

   <launcher name="capella2sysmlv2">
      <win useIco="false">
         <bmp/>
      </win>
   </launcher>

   <vm>
      <linux include="false">org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21</linux>
      <macos include="false">org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21</macos>
      <windows include="false">org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21</windows>
   </vm>

   <plugins>
   </plugins>

   <features>
      <feature id="org.eclipse.capella.sysmlv2.bridge.headless.feature"/>
      <feature id="org.eclipse.equinox.executable"/>
   </features>

   <configurations>
      <plugin id="org.eclipse.capella.sysmlv2.bridge.application" autoStart="true" startLevel="5" />
      <plugin id="org.eclipse.core.contenttype" autoStart="true" startLevel="3" />
      <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="4" />
      <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.preferences" autoStart="true" startLevel="3" />
      <plugin id="org.eclipse.equinox.registry" autoStart="true" startLevel="3" />
      <plugin id="org.eclipse.equinox.simpleconfigurator" autoStart="true" startLevel="1" />
   </configurations>

   <preferencesInfo>
      <targetfile overwrite="false"/>
   </preferencesInfo>

   <cssInfo>
   </cssInfo>

</product>
