<product name="Capella SysML v2 Bridge" uid="org.eclipse.capella.sysmlv2.bridge.product" id="org.eclipse.capella.sysmlv2.bridge.application.product" application="org.eclipse.capella.sysmlv2.bridge.application" version="0.1.0.qualifier" type="features" includeLaunchers="true" autoIncludeRequirements="true">

   <configIni use="default">
   </configIni>

