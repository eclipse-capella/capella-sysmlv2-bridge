<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.capella.sysmlv2</groupId>
        <artifactId>capella-sysmlv2-eclipse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>org.eclipse.capella.sysmlv2.bridge.product.tests</artifactId>
    <packaging>jar</packaging>

    <properties>
        <capella.source.commit>8e92bb0cb4bfa90ab08bac68c36ab273702d64b7</capella.source.commit>
        <capella.ife.base.url>https://raw.githubusercontent.com/eclipse-capella/capella/${capella.source.commit}/samples/In-Flight%20Entertainment%20System</capella.ife.base.url>
        <maven.failsafe.version>3.5.2</maven.failsafe.version>
        <capella.java.executable>${java.home}/bin/java</capella.java.executable>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>provision-ife-model</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/ife/In-Flight Entertainment System"/>
                                <delete dir="${project.build.directory}/runtime" quiet="true"/>
                                <get src="${capella.ife.base.url}/.project"
                                     dest="${project.build.directory}/ife/In-Flight Entertainment System/.project"
                                     skipexisting="true"/>
                                <get src="${capella.ife.base.url}/In-Flight%20Entertainment%20System.capella"
                                     dest="${project.build.directory}/ife/In-Flight Entertainment System/In-Flight Entertainment System.capella"
                                     skipexisting="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.failsafe.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <bridge.product.directory>${project.parent.basedir}/product/org.eclipse.capella.sysmlv2.bridge.product/target/products/org.eclipse.capella.sysmlv2.bridge.product/linux/gtk/x86_64</bridge.product.directory>
                        <runtime.test.output>${project.build.directory}/runtime</runtime.test.output>
                        <capella.ife.project>${project.build.directory}/ife/In-Flight Entertainment System</capella.ife.project>
                        <capella.java.executable>${capella.java.executable}</capella.java.executable>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
