<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.obeonetwork.capella.sysmlv2</groupId>
        <artifactId>capella-sysmlv2-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <groupId>org.eclipse.capella.sysmlv2</groupId>
    <artifactId>capella-sysmlv2-eclipse-parent</artifactId>
    <packaging>pom</packaging>

    <properties>
        <tycho.version>4.0.12</tycho.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>plugins/org.eclipse.capella.sysmlv2.bridge.transformer</module>
        <module>plugins/org.eclipse.capella.sysmlv2.bridge.mappings</module>
        <module>plugins/org.eclipse.capella.sysmlv2.bridge.application</module>
        <module>tests/org.eclipse.capella.sysmlv2.bridge.mappings.tests</module>
        <module>tests/org.eclipse.capella.sysmlv2.bridge.application.tests</module>
        <module>features/org.eclipse.capella.sysmlv2.bridge.headless.feature</module>
    </modules>

    <repositories>
        <repository>
            <id>github-syson</id>
            <url>https://maven.pkg.github.com/eclipse-syson/syson</url>
        </repository>
        <repository>
            <id>github-sirius-web</id>
            <url>https://maven.pkg.github.com/eclipse-sirius/sirius-web</url>
        </repository>
        <repository>
            <id>github-sirius-emfjson</id>
            <url>https://maven.pkg.github.com/eclipse-sirius/sirius-emf-json</url>
        </repository>
        <repository>
            <id>github-arcadia</id>
            <!-- Temporary until the package is published by eclipse-capella. -->
            <url>https://maven.pkg.github.com/obeo/arcadia-sysmlv2-lib</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <target>
                        <artifact>
                            <groupId>org.eclipse.capella.sysmlv2</groupId>
                            <artifactId>capella-target-${capella.target.version}</artifactId>
                            <version>${project.version}</version>
                            <classifier>capella-${capella.target.version}</classifier>
                        </artifact>
	                    <executionEnvironmentDefault>JavaSE-21</executionEnvironmentDefault>
	                    <dependency-resolution>
	                        <optionalDependencies>ignore</optionalDependencies>
	                    </dependency-resolution>
                    </target>
					<environments>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
					</environments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
