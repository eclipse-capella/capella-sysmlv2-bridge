<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.obeonetwork.capella.sysmlv2</groupId>
    <artifactId>capella-sysmlv2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>capella2sysmlv2</name>
    <description>Standalone Capella to SysML v2 textual transformation.</description>

    <modules>
        <module>test-support</module>
        <module>capella-loader</module>
        <module>capella2sysmlv2-transformer</module>
        <module>cli</module>
        <module>integration-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <assertj.version>3.27.3</assertj.version>
        <junit.version>6.1.3</junit.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <syson.version>2026.9.2</syson.version>
        <capella.for.syson.version>2026.9.2</capella.for.syson.version>
        <sirius-web.version>2026.9.2</sirius-web.version>
        <spring.version>7.0.8</spring.version>
        <slf4j.version>2.0.18</slf4j.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <emfjson.version>2.5.3-SNAPSHOT</emfjson.version>
        <arcadia-library.version>0.0.3</arcadia-library.version>
        <emf.version>2.42.0</emf.version>
        <ecore-xmi.version>2.40.0</ecore-xmi.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-io.version>2.15.1</commons-io.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
        <commons-text.version>1.10.0</commons-text.version>
    </properties>

    <repositories>
        <repository>
            <id>github-syson</id>
            <url>https://maven.pkg.github.com/eclipse-syson/syson</url>
        </repository>
        <repository>
            <id>github-sirius-web</id>
            <url>https://maven.pkg.github.com/eclipse-sirius/sirius-web</url>
        </repository>
        <repository>
            <id>github-sirius-emfjson</id>
            <url>https://maven.pkg.github.com/eclipse-sirius/sirius-emf-json</url>
        </repository>
        <repository>
            <id>github-capella-for-syson</id>
            <url>https://maven.pkg.github.com/eclipse-capella/capella-for-syson</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.eclipse.syson</groupId>
                <artifactId>syson-sysml-metamodel</artifactId>
                <version>${syson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.obeonetwork.capella.sysmlv2</groupId>
                <artifactId>test-support</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>capella-product-7.1.0</id>
            <properties>
                <capella.target.version>7.1.0</capella.target.version>
            </properties>
            <modules>
                <module>eclipse</module>
                <module>eclipse/target-platform-${capella.target.version}</module>
                <module>eclipse/product/org.eclipse.capella.sysmlv2.bridge.product.${capella.target.version}</module>
                <module>eclipse/official-product-it</module>
            </modules>
            <repositories>
                <repository>
                    <id>capella-7.1.0</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/capella/core/updates/releases/7.1.0/org.polarsys.capella.rcp.site/</url>
                </repository>
                <repository>
                    <id>sirius-7.4.14</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/sirius/updates/releases/7.4.14/2023-03/</url>
                </repository>
                <repository>
                    <id>eclipse-2023-03</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/releases/2023-03/</url>
                </repository>
                <repository>
                    <id>kitalpha-7.0.1</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/kitalpha/updates/releases/runtime/7.0.1/</url>
                </repository>
                <repository>
                    <id>diffmerge-0.15.0</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/diffmerge/releases/0.15.0/emf-diffmerge-site/</url>
                </repository>
            </repositories>
        </profile>
        <profile>
            <id>capella-product-7.0.1</id>
            <properties>
                <capella.target.version>7.0.1</capella.target.version>
            </properties>
            <modules>
                <module>eclipse/target-platform-${capella.target.version}</module>
                <module>eclipse</module>
                <module>eclipse/product/org.eclipse.capella.sysmlv2.bridge.product.${capella.target.version}</module>
                <module>eclipse/official-product-it</module>
            </modules>
            <repositories>
                <repository>
                    <id>capella-7.0.1</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/capella/core/updates/releases/7.0.1/org.polarsys.capella.rcp.site/</url>
                </repository>
                <repository>
                    <id>sirius-7.4.5</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/sirius/updates/releases/7.4.5/2023-03/</url>
                </repository>
                <repository>
                    <id>eclipse-2023-03</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/releases/2023-03/</url>
                </repository>
                <repository>
                    <id>kitalpha-7.0.1</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/kitalpha/updates/releases/runtime/7.0.1/</url>
                </repository>
                <repository>
                    <id>diffmerge-0.15.0</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/diffmerge/releases/0.15.0/emf-diffmerge-site/</url>
                </repository>
            </repositories>
        </profile>
        <profile>
            <id>capella-product-6.1.0</id>
            <properties>
                <capella.target.version>6.1.0</capella.target.version>
            </properties>
            <modules>
                <module>eclipse/target-platform-${capella.target.version}</module>
                <module>eclipse</module>
                <module>eclipse/product/org.eclipse.capella.sysmlv2.bridge.product.${capella.target.version}</module>
            </modules>
            <repositories>
                <repository>
                    <id>capella-6.1.0</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/capella/core/updates/releases/6.1.0/org.polarsys.capella.rcp.site/</url>
                </repository>
                <repository>
                    <id>sirius-7.1.0</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/sirius/updates/releases/7.1.0/2021-06/</url>
                </repository>
                <repository>
                    <id>eclipse-2021-06</id>
                    <layout>p2</layout>
                    <url>http://download.eclipse.org/releases/2021-06</url>
                </repository>
                <repository>
                    <id>kitalpha-6.1.0</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/kitalpha/updates/stable/runtime/6.1.0.20230322/</url>
                </repository>
                <repository>
                    <id>diffmerge-0.14.1</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/diffmerge/stable/0.14.1-S20230321/emf-diffmerge-site/</url>
                </repository>
            </repositories>
        </profile>
    </profiles>
</project>
